#!/usr/bin/env bash

if (( BASH_VERSINFO[0] < 4 )); then
    echo "tmux-session-overview requires bash 4+. On macOS: brew install bash" >&2
    exit 1
fi

shopt -s extglob

PINK=$'\033[38;2;255;80;115m'
GRAY=$'\033[38;2;136;136;136m'
GREEN=$'\033[38;2;80;220;100m'
YELLOW=$'\033[38;2;255;200;80m'
BLUE=$'\033[38;2;90;160;255m'
WHITE=$'\033[38;2;210;210;210m'
BOLD=$'\033[1m'
RESET=$'\033[0m'
ESC=$'\033'

GUTTER="   "

detect_claude_state() {
    local target="$1"
    local content
    content=$(tmux capture-pane -p -t "$target" 2>/dev/null | tail -16)

    # Order matters. The persistent footer — e.g.
    #   ⏵⏵ accept edits on (shift+tab to cycle) · esc to interrupt
    #   ⏸ plan mode on (shift+tab to cycle)
    # is on screen in almost every state, so "shift+tab to cycle" alone can't
    # mean idle. We test the most specific signals first and fall through to the
    # bare idle footer last.

    # 1) Waiting on the user. Keep these markers UI-only and rare in prose —
    #    matching phrases like "do you want to proceed?" would false-positive on
    #    Claude's own on-screen text and flag a busy pane as "needs answer".
    if echo "$content" | grep -qiE 'esc to cancel|tab to amend'; then
        echo "question"

    # 2) Working. "esc to interrupt" is the usual marker, but while subagents
    #    run the live agent tree (● main / ◯ Agent) is drawn BELOW the footer
    #    and the interrupt hint can scroll off — leaving only "shift+tab to
    #    cycle", which would otherwise read as idle. So also treat the live
    #    timer+token meter ("57s · ↓ 42.5k tokens", "(1m 26s · ↑ … tokens)") as
    #    working: it only appears while something is actively running. Likewise
    #    catch the context-compaction spinner.
    elif echo "$content" | grep -qi 'esc to interrupt'; then
        echo "working"
    elif echo "$content" | grep -qE '(↑|↓)[[:space:]]*[0-9][0-9.]*k?[[:space:]]*tokens'; then
        echo "working"
    elif echo "$content" | grep -qiE 'compacting|summarizing conversation'; then
        echo "working"

    # 3) Idle, ready for input — any mode banner or shortcut hint.
    elif echo "$content" | grep -qiE 'for shortcuts|shift.tab to cycle|for agents|for newline'; then
        echo "ready"
    else
        echo "active"
    fi
}

# Coloured one-line cell for a pane.
pane_cell() {
    local sname="$1" widx="$2" pidx="$3" pcmd="$4" plabel="$5" state="active"
    # claude may run locally (claude/node) or over ssh on a dev box. tmux-start
    # tags the claude pane with @label "claude", which is the reliable signal
    # over ssh where the command is just "ssh" (same as the plain terminal pane).
    # For unlabelled ssh panes we still inspect the content: a definite claude
    # marker means it's claude, otherwise it's a remote shell shown as ssh.
    if [[ "$plabel" == "claude" || "$pcmd" == *claude* || "$pcmd" == "node" || "$pcmd" == "ssh" ]]; then
        state="$(detect_claude_state "${sname}:${widx}.${pidx}")"
    fi
    if [[ "$plabel" == "claude" || "$pcmd" == *claude* || "$pcmd" == "node" ]] \
        || [[ "$state" == "question" || "$state" == "working" || "$state" == "ready" ]]; then
        case "$state" in
            question) printf "${BLUE}${BOLD}● claude [needs answer]${RESET}" ;;
            working)  printf "${YELLOW}● claude [working]${RESET}" ;;
            ready)    printf "${GREEN}● claude [ready]${RESET}" ;;
            *)        printf "${WHITE}○ claude [typing?]${RESET}" ;;
        esac
    else
        # Prefer the pane's @label (e.g. "sessions", "clock") over the raw
        # command, which would otherwise just read "bash".
        printf "${GRAY}○ %s${RESET}" "${plabel:-$pcmd}"
    fi
}

# Visible length of a string, ignoring ANSI colour codes.
vislen() {
    local stripped=${1//${ESC}\[*([0-9;])m/}
    printf '%s' "${#stripped}"
}

# Truncate a (possibly colour-coded) string to at most $2 visible columns,
# copying ANSI CSI sequences through without counting them. Appends … when it
# has to cut, and always closes with RESET so colour never bleeds past the cell.
clip() {
    local s="$1" max="$2"
    [[ -z "$s" ]] && return
    local vw; vw=$(vislen "$s")
    (( vw <= max )) && { printf '%s' "$s"; return; }
    local limit=$(( max - 1 )); (( limit < 0 )) && limit=0
    local out="" vis=0 i=0 n=${#s} c
    while (( i < n )); do
        c="${s:i:1}"
        if [[ "$c" == "$ESC" ]]; then
            out+="$c"; ((i++))
            if [[ "${s:i:1}" == "[" ]]; then
                out+="["; ((i++))
                while (( i < n )); do c="${s:i:1}"; out+="$c"; ((i++)); [[ "$c" == [a-zA-Z] ]] && break; done
            fi
            continue
        fi
        (( vis >= limit )) && break
        out+="$c"; ((vis++)); ((i++))
    done
    printf '%s…%s' "$out" "$RESET"
}

CLR_EOL=$'\033[K'

# Layout state shared between the renderer and the click handler.
declare -A CLICK_MAP   # "absolute_col:row" -> "session:<name>" or "pane:<sess>:<win>:<pane>"
COLS_BLOCKS=()
maxrows=0
colw=0
FRAME=""

LEFT_MARGIN=2          # cells reserved at the left edge for the ‹ scroll marker
CROWD_CAP=16           # cap on column width once scrolling is needed
VIEW_START=0           # absolute index of the leftmost visible session column
VISIBLE=0              # number of session columns currently on screen
MARK_L="‹"             # hidden-sessions-to-the-left marker
MARK_R="›"             # hidden-sessions-to-the-right marker

# Build the printable frame and the click map for the current tmux state.
# The grid starts on terminal line 2 (1-indexed): line 1 is a blank spacer (the
# "sessions" label now lives in the pane border). Each grid row r maps to
# mouse_y = r + 2. Within a row, column c's content spans mouse_x in
# [2 + c*(colw+3), that + colw).
build_frame() {
    local current_session sname widx pidx pcmd block lineno _l _w cidx=0 current_idx=0
    # Anchor to this pane's own session so each overview highlights (and scrolls
    # to) itself deterministically, regardless of which client is where.
    current_session=$(tmux display-message -p -t "${TMUX_PANE:-}" '#S' 2>/dev/null)
    [[ -n "$current_session" ]] || current_session=$(tmux display-message -p '#S' 2>/dev/null)

    CLICK_MAP=()
    COLS_BLOCKS=()
    maxrows=0
    colw=0

    # Build one column per session (lines joined by \x01): session name on top,
    # its panes listed underneath. Columns print side by side.
    #
    # The current session is shown purely by colour (pink vs white) — no arrow or
    # other marker. Every column is therefore the same width regardless of which
    # session is selected, so switching the current session never shifts the
    # layout. Panes use one uniform indent for the same reason.
    while IFS=$'\t' read -r sname sdown; do
        if [[ "$sname" == "$current_session" ]]; then
            block="${PINK}${BOLD}${sname}${RESET}"
            current_idx=$cidx
        else
            block="${BOLD}${WHITE}${sname}${RESET}"
        fi
        # ssh-pane sets @ssh_down to the host name while its dev box is
        # unreachable; flag it with a yellow ⚠ prefix while leaving the name in
        # its normal colour (pink = current session, white = the rest).
        [[ -n "$sdown" ]] && block="${YELLOW}${BOLD}⚠ ${RESET}${block}"
        CLICK_MAP["$cidx:0"]="session:$sname"
        lineno=1

        while IFS=: read -r widx; do
            while IFS=$'\t' read -r pidx pcmd plabel; do
                block+=$'\x01'"  $(pane_cell "$sname" "$widx" "$pidx" "$pcmd" "$plabel")"
                CLICK_MAP["$cidx:$lineno"]="pane:$sname:$widx:$pidx"
                ((lineno++))
            done < <(tmux list-panes -t "${sname}:${widx}" \
                -F "#{pane_index}	#{pane_current_command}	#{@label}" 2>/dev/null)
        done < <(tmux list-windows -t "$sname" \
            -F "#{window_index}" 2>/dev/null)

        COLS_BLOCKS+=("$block")
        IFS=$'\x01' read -ra _lines <<< "$block"
        (( ${#_lines[@]} > maxrows )) && maxrows=${#_lines[@]}
        for _l in "${_lines[@]}"; do
            _w=$(vislen "$_l"); (( _w > colw )) && colw=$_w
        done
        ((cidx++))
    done < <(tmux list-sessions -F "#{session_name}	#{@ssh_down}" 2>/dev/null)

    # Fit the columns to the pane, scrolling when there are too many to show.
    # A row is: LEFT_MARGIN cells (the ‹ marker), then VISIBLE session columns
    # each colw wide separated by GUTTER (3), then an optional › marker. If every
    # column fits we show them all at natural width (full names); otherwise we cap
    # the width to surface more columns and scroll a window that always keeps the
    # current session on screen. Hidden columns are flagged ‹ / › and reached by
    # clicking a visible session or pressing ←/→.
    local ncols=${#COLS_BLOCKS[@]} pane_w hard stride max_start
    pane_w=$(tmux display-message -p -t "${TMUX_PANE:-}" '#{pane_width}' 2>/dev/null)
    [[ "$pane_w" =~ ^[0-9]+$ ]] || pane_w=$(tput cols 2>/dev/null)
    [[ "$pane_w" =~ ^[0-9]+$ ]] || pane_w=80
    (( ncols < 1 )) && ncols=1

    # No single column may exceed the pane (minus the left margin and a › cell).
    hard=$(( pane_w - LEFT_MARGIN - 1 )); (( hard < 4 )) && hard=4
    (( colw > hard )) && colw=$hard

    stride=$(( colw + 3 ))
    VISIBLE=$(( (pane_w - LEFT_MARGIN) / stride )); (( VISIBLE < 1 )) && VISIBLE=1
    if (( VISIBLE < ncols )); then
        # Crowded: cap width to show more columns, then recompute the count.
        (( colw > CROWD_CAP )) && colw=$CROWD_CAP
        stride=$(( colw + 3 ))
        VISIBLE=$(( (pane_w - LEFT_MARGIN) / stride )); (( VISIBLE < 1 )) && VISIBLE=1
    fi
    (( VISIBLE > ncols )) && VISIBLE=$ncols

    # Slide the viewport only as far as needed to keep the current session in it.
    (( current_idx < VIEW_START )) && VIEW_START=$current_idx
    (( current_idx >= VIEW_START + VISIBLE )) && VIEW_START=$(( current_idx - VISIBLE + 1 ))
    max_start=$(( ncols - VISIBLE )); (( max_start < 0 )) && max_start=0
    (( VIEW_START > max_start )) && VIEW_START=$max_start
    (( VIEW_START < 0 )) && VIEW_START=0

    local hidden_left=0 hidden_right=0
    (( VIEW_START > 0 )) && hidden_left=1
    (( VIEW_START + VISIBLE < ncols )) && hidden_right=1

    FRAME=$(
        printf "\n"
        for (( r = 0; r < maxrows; r++ )); do
            # Left margin (2 cells); the ‹ marker shows on the top row only.
            if (( r == 0 && hidden_left )); then
                printf '%s%s%s ' "$GRAY" "$MARK_L" "$RESET"
            else
                printf '  '
            fi
            for (( j = 0; j < VISIBLE; j++ )); do
                ci=$(( VIEW_START + j ))
                IFS=$'\x01' read -ra lines <<< "${COLS_BLOCKS[ci]}"
                cell="$(clip "${lines[r]:-}" "$colw")"
                pad=$(( colw - $(vislen "$cell") )); (( pad < 0 )) && pad=0
                if (( j == VISIBLE - 1 && r == 0 && hidden_right )); then
                    # › replaces the trailing gutter on the top row.
                    printf '%s%*s %s%s%s' "$cell" "$pad" "" "$GRAY" "$MARK_R" "$RESET"
                else
                    printf '%s%*s%s' "$cell" "$pad" "" "$GUTTER"
                fi
            done
            printf "\n"
        done
    )
}

# Cycle to the adjacent session and focus its overview pane.
handle_nav() {
    local dir="$1"
    local -a sessions
    mapfile -t sessions < <(tmux list-sessions -F "#{session_name}" 2>/dev/null)
    (( ${#sessions[@]} < 2 )) && return
    local current idx next
    current=$(tmux display-message -p '#S' 2>/dev/null)
    idx=0
    for i in "${!sessions[@]}"; do
        [[ "${sessions[$i]}" == "$current" ]] && idx=$i && break
    done
    if [[ "$dir" == "right" ]]; then
        next=$(( (idx + 1) % ${#sessions[@]} ))
    else
        next=$(( (idx - 1 + ${#sessions[@]}) % ${#sessions[@]} ))
    fi
    local target="${sessions[$next]}"
    tmux switch-client -t "$target" 2>/dev/null
    tmux select-pane -t "${target}:0.0" 2>/dev/null
}

# Map a click at (x, y) — 1-indexed terminal cells — to a tmux target and jump.
# Columns begin after the LEFT_MARGIN, and only VISIBLE of them are on screen
# starting at VIEW_START, so the visible column index is offset into the full set.
handle_click() {
    local x="$1" y="$2" r stride rel c off target s rest w p
    r=$(( y - 2 ))
    (( r < 0 )) && return
    stride=$(( colw + 3 ))
    (( stride <= 0 )) && return
    rel=$(( x - 1 - LEFT_MARGIN ))   # first column starts just past the margin
    (( rel < 0 )) && return          # clicked in the left margin / ‹ marker
    c=$(( rel / stride ))
    off=$(( rel - c * stride ))
    (( off >= colw )) && return      # clicked in the gutter between columns
    (( c >= VISIBLE )) && return     # clicked past the last visible column / › marker
    c=$(( VIEW_START + c ))          # translate to the absolute session index

    target="${CLICK_MAP["$c:$r"]:-}"
    [[ -z "$target" ]] && return

    case "$target" in
        session:*)
            s="${target#session:}"
            tmux switch-client -t "$s" 2>/dev/null
            ;;
        pane:*)
            rest="${target#pane:}"
            s="${rest%%:*}"; rest="${rest#*:}"
            w="${rest%%:*}"; p="${rest#*:}"
            tmux switch-client -t "$s" 2>/dev/null
            tmux select-window -t "$s:$w" 2>/dev/null
            tmux select-pane -t "$s:$w.$p" 2>/dev/null
            ;;
    esac
}

# Hide cursor and enable SGR mouse reporting while drawing; restore on exit.
# Ctrl+C / SIGTERM exit, which fires the EXIT trap to restore the terminal.
cleanup() { printf '\033[?1000l\033[?1006l\033[?25h\033[2J\033[H'; }
trap cleanup EXIT
trap 'exit 0' INT TERM

# Mouse clicks only reach this program when tmux mouse mode is on.
tmux set -g mouse on 2>/dev/null
printf '\033[?25l\033[?1000h\033[?1006h\033[2J'

# The leading '<' is consumed as ch3 before seq is built, so it is NOT part of
# seq here — match what's left: btn ; x ; y and the trailing M (press) / m (release).
mouse_re='^([0-9]+);([0-9]+);([0-9]+)([Mm])$'

while true; do
    build_frame

    # Redraw in place: home cursor, clear each line as we overwrite it,
    # then clear anything left below from a previous, taller frame.
    printf '\033[H%s%s\033[J' "${FRAME//$'\n'/$CLR_EOL$'\n'}" "$CLR_EOL"

    # Wait up to 1s for input.
    # Mouse: ESC [ < btn ; x ; y M  — left-click jumps to session/pane.
    # Keyboard: ESC [ C (right) / ESC [ D (left) — cycle sessions.
    if IFS= read -rsn1 -t 1 ch; then
        if [[ "$ch" == "$ESC" ]]; then
            IFS= read -rsn1 -t 0.05 ch2
            if [[ "$ch2" == "[" ]]; then
                IFS= read -rsn1 -t 0.05 ch3
                case "$ch3" in
                    "<")
                        seq=""
                        while IFS= read -rsn1 -t 0.02 ch4; do
                            seq+="$ch4"
                            [[ "$ch4" == [Mm] ]] && break
                        done
                        if [[ "$seq" =~ $mouse_re ]]; then
                            btn="${BASH_REMATCH[1]}"
                            mx="${BASH_REMATCH[2]}"
                            my="${BASH_REMATCH[3]}"
                            act="${BASH_REMATCH[4]}"
                            [[ "$btn" == "0" && "$act" == "M" ]] && handle_click "$mx" "$my"
                        fi
                        ;;
                    "C") handle_nav right ;;
                    "D") handle_nav left ;;
                esac
            fi
        fi
    fi
done
