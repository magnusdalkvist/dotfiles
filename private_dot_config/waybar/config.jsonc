// waybar — minimal
//
// Everything sits on the right. There is no workspace indicator: workspaces go
// unused on this machine, so a permanent "1" was a label for a feature nobody
// touches. The Super+1..9 bindings still work if that ever changes.
//
// Network and bluetooth are waybar's own modules rather than the nm-applet and
// blueman-applet tray icons, which are drawn from a dated GTK icon set and open
// GTK2-era popup menus. These are Nerd Font glyphs in the same palette as the
// rest of the bar, and clicking them opens a real window instead of a menu:
//
//   network    -> GNOME Settings Wi-Fi. Needs XDG_CURRENT_DESKTOP=GNOME or it
//                 refuses to start outside GNOME. Verified working under sway.
//   bluetooth  -> blueman-manager. GNOME Settings' bluetooth panel reports
//                 "No Bluetooth Found" under sway even though hci0 is present
//                 and unblocked, so it is deliberately not used here.
//
// The tray stays for Slack and Cloudflare WARP, which have nowhere else to live.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,

  "margin-top": 4,
  "margin-left": 14,
  "margin-right": 14,

  "modules-left": ["sway/mode"],
  "modules-center": [],
  "modules-right": ["tray", "bluetooth", "network", "pulseaudio", "battery", "clock"],

  "sway/mode": {
    // Only visible while resize mode is active.
    "format": "{}"
  },

  "tray": {
    "icon-size": 15,
    "spacing": 14
  },

  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    // A count only when something is actually connected -- otherwise the glyph
    // alone says all there is to say.
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },

  "network": {
    // Icon only; the SSID and signal live in the tooltip so the bar stays quiet.
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-linked": "󰈂",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid}   {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Offline",
    "on-click": "env XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi"
  },

  "pulseaudio": {
    "format": "{icon} {volume}",
    "format-muted": "󰝟",
    "format-bluetooth": "󰂯 {volume}",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "scroll-step": 5,
    "tooltip": false
  },

  "battery": {
    "states": { "warning": 25, "critical": 12 },
    "format": "{capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "tooltip-format": "{timeTo}  ({power}W)",
    "interval": 30
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "months": "<span color='#111b22'><b>{}</b></span>",
        "weeks": "<span color='#565d64'>{}</span>",
        "weekdays": "<span color='#565d64'><b>{}</b></span>",
        "today": "<span color='#b31675'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  }
}
