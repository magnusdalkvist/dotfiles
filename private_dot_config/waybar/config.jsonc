// waybar — minimal
//
// Design rule: the bar shows only what nothing else on this desktop already
// shows. Three things were cut on those grounds rather than restyled:
//
//   window title  -- sway marks the focused window with a magenta border, so a
//                    centre label repeated it. Removing it leaves the middle of
//                    the bar empty, which is what makes it read as calm.
//   temperature   -- the tmux status bar already reports CPU temp continuously.
//   network       -- nm-applet sits in the tray and already indicates the
//                    connection state, so a second wifi glyph said nothing new.
//
// What is left is four groups: tray, volume, battery, clock.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,

  "margin-top": 4,
  "margin-left": 14,
  "margin-right": 14,

  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": [],
  "modules-right": ["tray", "pulseaudio", "battery", "clock"],

  "sway/workspaces": {
    // Numbers only, and only workspaces that exist -- no persistent 1-9 row of
    // mostly-empty slots. Colour alone marks the active one.
    "format": "{name}",
    "disable-scroll": true,
    "all-outputs": true
  },

  "sway/mode": {
    // Only ever visible while resize mode is active.
    "format": "{}"
  },

  "tray": {
    // Slack and Cloudflare WARP both live here.
    "icon-size": 15,
    "spacing": 14
  },

  "pulseaudio": {
    "format": "{icon} {volume}",
    "format-muted": "󰝟",
    "format-bluetooth": "󰂯 {volume}",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "scroll-step": 5,
    "tooltip": false
  },

  "battery": {
    "states": { "warning": 25, "critical": 12 },
    // Percentage only at a glance; the icon appears when charging, because that
    // is the only time the state is not obvious from the number alone.
    "format": "{capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "tooltip-format": "{timeTo}  ({power}W)",
    "interval": 30
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "months": "<span color='#111b22'><b>{}</b></span>",
        "weeks": "<span color='#565d64'>{}</span>",
        "weekdays": "<span color='#565d64'><b>{}</b></span>",
        "today": "<span color='#b31675'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  }
}
